[Unit]
Description=codex-wechat agent (HTTP Codex backend, no WeChat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/apps/codex-wechat
Environment=PATH=/usr/local/bin:/usr/bin
Environment=CODEX_WECHAT_MACHINE=vps-agent
Environment=CODEX_WECHAT_AGENT_HOST=127.0.0.1
Environment=CODEX_WECHAT_AGENT_PORT=18765
# Create with: codex-wechat agent-token
# File content: CODEX_WECHAT_AGENT_TOKEN=<generated-token>
EnvironmentFile=/home/YOUR_USER/.config/codex-wechat/agent.env
ExecStart=/usr/bin/node /home/YOUR_USER/apps/codex-wechat/dist/src/cli.js agent
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
